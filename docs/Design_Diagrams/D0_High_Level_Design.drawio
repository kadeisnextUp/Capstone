        <mxCell id="title" value='&lt;b style="font-size:20px"&gt;Campus Companion: D0 Block Diagram&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style="font-size:18px"&gt;Team: Kaden Sawyer, Laila Raines&lt;/b&gt;&lt;div style="margin-top:6px;font-size:16px"&gt;&lt;b&gt;Goal:&lt;/b&gt; Help first-year and transfer students at the University of Cincinnati get to class on time and find campus events that fit their schedule and interests.&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Tahoma;" vertex="1" parent="1">
