<mxfile host="Electron" pages="4">
  <diagram name="D2 Complete System" id="d2-system">
    <mxGraphModel dx="1243" dy="880" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d2-system-title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Campus Companion: D2 Complete System&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:18px&quot;&gt;Team: Kaden Sawyer, Laila Raines&lt;/b&gt;&lt;div style=&quot;margin-top:6px;font-size:16px&quot;&gt;&lt;b&gt;Goal:&lt;/b&gt; Help first-year and transfer students at the University of Cincinnati get to class on time and find campus events that fit their schedule and interests.&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="1360" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-frame" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E00122;strokeWidth=2;fontColor=#E00122;fontSize=15;align=center;verticalAlign=top;spacingTop=4;fontFamily=Tahoma;" value="&lt;b&gt;Separate server everything communicates to&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Python + FastAPI, host to be chosen (Q1)&lt;/span&gt;" vertex="1">
          <mxGeometry height="760" width="770" x="320" y="140" as="geometry" />
        </mxCell>
        <mxCell id="p1-apps" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mobile and web apps (A1, A2)&lt;/b&gt;&lt;br&gt;React Native app for students and club heads&lt;br&gt;React + Vite web app and admin portal&lt;br&gt;Both draw each walk on a map" vertex="1">
          <mxGeometry height="145" width="220" x="30" y="155" as="geometry" />
        </mxCell>
        <mxCell id="p1-E3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;E3 Map tiles&lt;/b&gt; (reused)&lt;br&gt;OpenFreeMap background map, built from OpenStreetMap data" vertex="1">
          <mxGeometry height="80" width="220" x="30" y="345" as="geometry" />
        </mxCell>
        <mxCell id="p1-E1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;E1 Open Map Data&lt;/b&gt;&lt;br&gt;OpenStreetMap buildings and paths, imported by hand" vertex="1">
          <mxGeometry height="80" width="220" x="30" y="480" as="geometry" />
        </mxCell>
        <mxCell id="p1-expo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Expo Push Service&lt;/b&gt; (reused)&lt;br&gt;Relays notices to Apple and Google, which deliver them to phones" vertex="1">
          <mxGeometry height="90" width="220" x="30" y="725" as="geometry" />
        </mxCell>
        <mxCell id="p1-E2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;E2 Campus Links&lt;/b&gt;&lt;br&gt;GetInvolvedUC, UC&#x27;s list of student organizations, checked by an admin" vertex="1">
          <mxGeometry height="90" width="190" x="1150" y="190" as="geometry" />
        </mxCell>
        <mxCell id="p1-supa" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;fontFamily=Tahoma;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Supabase&lt;/b&gt; (reused)&lt;br&gt;&lt;br&gt;PostgreSQL: the D1 tables plus four new tables (Figure 2)&lt;br&gt;&lt;br&gt;Database functions for writes that must happen together&lt;br&gt;&lt;br&gt;Supabase Auth: sign-in, login tokens, admin role" vertex="1">
          <mxGeometry height="420" width="230" x="1150" y="330" as="geometry" />
        </mxCell>
        <mxCell id="p1-C1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C1 Information Check&lt;/b&gt;&lt;br&gt;Reads the schedule PDF; saves the courses, interests, and consent the student confirms; deletes them on request" vertex="1">
          <mxGeometry height="80" width="330" x="345" y="200" as="geometry" />
        </mxCell>
        <mxCell id="p1-C2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C2 Route Planner&lt;/b&gt;&lt;br&gt;Imports map data, stores walking times between all 62 buildings, and returns each day&#x27;s walks" vertex="1">
          <mxGeometry height="80" width="330" x="345" y="330" as="geometry" />
        </mxCell>
        <mxCell id="p1-C3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C3 Event Check&lt;/b&gt;&lt;br&gt;Suggests events in the student&#x27;s categories that fit between classes, with time to walk" vertex="1">
          <mxGeometry height="80" width="330" x="345" y="460" as="geometry" />
        </mxCell>
        <mxCell id="p1-C4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C4 Club Check&lt;/b&gt;&lt;br&gt;Handles club verification requests and checks that a poster heads a verified club" vertex="1">
          <mxGeometry height="70" width="330" x="735" y="200" as="geometry" />
        </mxCell>
        <mxCell id="p1-C5" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C5 Club Categories&lt;/b&gt;&lt;br&gt;Stores each club&#x27;s categories and limits each event to them" vertex="1">
          <mxGeometry height="70" width="330" x="735" y="320" as="geometry" />
        </mxCell>
        <mxCell id="p1-C6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C6 Event Classifier&lt;/b&gt;&lt;br&gt;Checks, saves, lists, and cancels events with their categories" vertex="1">
          <mxGeometry height="80" width="330" x="735" y="460" as="geometry" />
        </mxCell>
        <mxCell id="p1-C7" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C7 Interest Finder&lt;/b&gt;&lt;br&gt;Finds the students whose interests match and queues their notices" vertex="1">
          <mxGeometry height="70" width="330" x="735" y="600" as="geometry" />
        </mxCell>
