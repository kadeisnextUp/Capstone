          <mxGeometry height="70" width="290" x="870" y="150" as="geometry" />
        </mxCell>
        <mxCell id="p3-d6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;fontFamily=Tahoma;spacing=2;spacingLeft=30;spacingRight=30;" value="&lt;b&gt;C7:&lt;/b&gt; Event still published and not started?" vertex="1">
          <mxGeometry height="100" width="280" x="870" y="255" as="geometry" />
        </mxCell>
        <mxCell id="p3-d7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;fontFamily=Tahoma;spacing=2;spacingLeft=30;spacingRight=30;" value="&lt;b&gt;C7:&lt;/b&gt; Any interested students with a phone registered?" vertex="1">
          <mxGeometry height="110" width="280" x="870" y="390" as="geometry" />
        </mxCell>
        <mxCell id="p3-p3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E00122;strokeWidth=3;fontColor=#000000;fontSize=12;spacing=4;fontFamily=Tahoma;" value="&lt;b&gt;G2 sends batches of 100&lt;/b&gt;&lt;br&gt;to Expo Push Service (I11)" vertex="1">
          <mxGeometry height="70" width="280" x="870" y="535" as="geometry" />
        </mxCell>
        <mxCell id="p3-d8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;fontFamily=Tahoma;spacing=2;spacingLeft=30;spacingRight=30;" value="Expo accepted every batch?" vertex="1">
          <mxGeometry height="90" width="240" x="890" y="640" as="geometry" />
        </mxCell>
        <mxCell id="p3-ok2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;spacing=4;fontFamily=Tahoma;" value="&lt;b&gt;Job sent&lt;/b&gt;&lt;br&gt;Notices reach online phones within 60 s (AC-02.1). Over 60 s, G4 logs notification_budget_missed." vertex="1">
          <mxGeometry height="80" width="280" x="870" y="770" as="geometry" />
        </mxCell>
        <mxCell id="p3-sk1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;spacing=4;fontFamily=Tahoma;" value="Job &lt;b&gt;skipped&lt;/b&gt;: nothing is sent" vertex="1">
          <mxGeometry height="60" width="270" x="1190" y="275" as="geometry" />
        </mxCell>
        <mxCell id="p3-sk2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;spacing=4;fontFamily=Tahoma;" value="Job &lt;b&gt;skipped&lt;/b&gt;: 0 notices. Students still see the event in the list (D0 I10)." vertex="1">
          <mxGeometry height="60" width="270" x="1190" y="415" as="geometry" />
        </mxCell>
        <mxCell id="p3-d9" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;fontFamily=Tahoma;spacing=2;spacingLeft=30;spacingRight=30;" value="Attempts left (6 at most) and event not started?" vertex="1">
          <mxGeometry height="110" width="270" x="1195" y="630" as="geometry" />
        </mxCell>
        <mxCell id="p3-r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E00122;strokeWidth=3;fontColor=#000000;fontSize=12;spacing=4;fontFamily=Tahoma;" value="Job &lt;b&gt;retrying&lt;/b&gt;&lt;br&gt;Waits 5, 10, 20, 40, then 80 s" vertex="1">
          <mxGeometry height="70" width="270" x="1190" y="535" as="geometry" />
        </mxCell>
        <mxCell id="p3-f1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E00122;strokeWidth=3;fontColor=#000000;fontSize=12;spacing=4;fontFamily=Tahoma;" value="Job &lt;b&gt;failed&lt;/b&gt;, logged by G4. Students see the event in the list on next open (D0 I11)." vertex="1">
          <mxGeometry height="70" width="270" x="1190" y="775" as="geometry" />
        </mxCell>
        <mxCell id="p3-n1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;fontStyle=2;fontFamily=Tahoma;" value="&lt;b&gt;Per-phone errors:&lt;/b&gt; when Expo answers DeviceNotRegistered for one phone, G2 disables that token and the other phones still get the notice.&lt;br&gt;&lt;br&gt;&lt;b&gt;Server stops mid-send:&lt;/b&gt; the job&#x27;s 60 s lease runs out and the next check sends it again. Each notice carries a collapse ID, so a phone replaces the repeat instead of showing it twice." vertex="1">
          <mxGeometry height="120" width="590" x="870" y="880" as="geometry" />
        </mxCell>
