  <diagram name="D2 Event Posting Error Paths" id="d2-error-paths">
    <mxGraphModel dx="1243" dy="880" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1290" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d2-error-paths-title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Campus Companion: D2 Event Posting and Notice Flow, with Error Paths&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:18px&quot;&gt;Team: Kaden Sawyer, Laila Raines&lt;/b&gt;&lt;div style=&quot;margin-top:6px;font-size:16px&quot;&gt;&lt;b&gt;Goal:&lt;/b&gt; Help first-year and transfer students at the University of Cincinnati get to class on time and find campus events that fit their schedule and interests.&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="1460" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p3-capA" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#000000;fontSize=15;fontStyle=1;fontFamily=Tahoma;" value="1. Posting request (answers within 5 s)" vertex="1">
          <mxGeometry height="30" width="600" x="160" y="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-capB" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#000000;fontSize=15;fontStyle=1;fontFamily=Tahoma;" value="2. Notice job (60 s from posting to phones)" vertex="1">
