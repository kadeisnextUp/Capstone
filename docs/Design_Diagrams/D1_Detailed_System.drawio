  <diagram name="D1 Detailed System" id="t0F3IuUIxu_OusxiiknV">
    <mxGraphModel dx="1243" dy="880" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Campus Companion: D1 Detailed System&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;font-size:18px&quot;&gt;Team: Kaden Sawyer, Laila Raines&lt;/b&gt;&lt;div style=&quot;margin-top:6px;font-size:16px&quot;&gt;&lt;b&gt;Goal:&lt;/b&gt; Help first-year and transfer students at the University of Cincinnati get to class on time and find campus events that fit their schedule and interests.&lt;/div&gt;" vertex="1">
          <mxGeometry height="84" width="1200" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-frame" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E00122;strokeWidth=2;fontColor=#E00122;fontSize=15;align=center;verticalAlign=top;spacingTop=4;fontFamily=Tahoma;" value="&lt;b&gt;Separate server everything communicates to&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Python + FastAPI, host to be chosen&lt;/span&gt;" vertex="1">
          <mxGeometry height="560" width="520" x="330" y="145" as="geometry" />
        </mxCell>
        <mxCell id="p1-C1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C1 Information Check&lt;/b&gt;&lt;br&gt;Checks the uploaded schedule with the student, then saves the courses and interests they confirm" vertex="1">
          <mxGeometry height="70" width="470" x="355" y="205" as="geometry" />
        </mxCell>
        <mxCell id="p1-C2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C2 Route Planner&lt;/b&gt;&lt;br&gt;Works like a GPS app such as Apple Maps, Google Maps, or MapQuest, but on our own copy of campus paths, to give walking times between back-to-back classes" vertex="1">
          <mxGeometry height="80" width="470" x="355" y="315" as="geometry" />
        </mxCell>
        <mxCell id="p1-C3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C3 Event Check&lt;/b&gt;&lt;br&gt;If a student&#39;s interests match an event&#39;s category and the event doesn&#39;t conflict with their classes, it is suggested for their downtime. The check leaves time to walk there (15 minutes when the walk is unknown)." vertex="1">
          <mxGeometry height="100" width="470" x="355" y="435" as="geometry" />
        </mxCell>
        <mxCell id="p1-C6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E00122;strokeColor=#000000;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;C6 Event Classifier&lt;/b&gt;&lt;br&gt;Classifies events that clubs post and saves them with their categories" vertex="1">
          <mxGeometry height="70" width="470" x="355" y="580" as="geometry" />
        </mxCell>
        <mxCell id="p1-defer" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#000000;fontSize=12;fontStyle=2;fontFamily=Tahoma;" value="C4, C5, and C7 also run on this server and are detailed in D2." vertex="1">
          <mxGeometry height="36" width="470" x="355" y="660" as="geometry" />
        </mxCell>
        <mxCell id="p1-apps" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;spacing=4;fontFamily=Tahoma;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mobile and web apps&lt;/b&gt;&lt;br&gt;React Native mobile app&lt;br&gt;React + Vite web app and admin portal" vertex="1">
          <mxGeometry height="80" width="220" x="30" y="190" as="geometry" />
