        <mxCell id="p1-supa" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;fontFamily=Tahoma;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Supabase&lt;/b&gt; (reused)&lt;br&gt;&lt;br&gt;All stored data will be on Supabase: students&#39; schedules and clubs&#39; events&lt;br&gt;&lt;br&gt;PostgreSQL database and Supabase Auth login&lt;br&gt;&lt;br&gt;Tables are in Figure 2" vertex="1">
